http://plain.example {
	respond "plain"
}

# 🧭 A port with no scheme is **not** a plaintext site. Upstream decides
# automatic HTTPS by the port, not the scheme, so a hostname on anything but the
# HTTP port is served over TLS — and the site name still selects the virtual
# host. `http://` in front of the address is what asks for plaintext; that
# spelling is pinned by `a_port_without_a_scheme_is_not_a_plaintext_listener`,
# because two sites sharing a port must agree about TLS to compile at all.
ported.example:8080 {
	respond "ported"
}

:0 {
	respond "any port"
}
