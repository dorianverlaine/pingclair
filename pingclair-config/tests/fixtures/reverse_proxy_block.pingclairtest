api.example {
	reverse_proxy /v1/* {
		to 10.0.1.1:8080 10.0.1.2:8080
		lb_policy round_robin
		header_up X-Forwarded-Host {host}
		health_check {
			path /healthz
			interval 10s
			timeout 2s
		}
	}
}
