{
  "debug": false,
  "servers": [
    {
      "name": "app.example.test",
      "names": [
        "app.example.test"
      ],
      "bind": null,
      "listen": [
        "[::]:8080"
      ],
      "proxy_protocol_listen": [],
      "plaintext_listen": [
        "[::]:8080"
      ],
      "tls": null,
      "routes": [
        {
          "path": "/api*",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "request_headers",
                "set": {
                  "X-Request-Start": "pingclair"
                },
                "remove": [
                  "Cookie"
                ]
              },
              {
                "type": "rewrite",
                "strip_prefix": "/api",
                "strip_suffix": null,
                "replace": null,
                "regex": null,
                "regex_replace": null
              },
              {
                "type": "reverse_proxy",
                "upstreams": [
                  "10.0.0.10:8080",
                  "10.0.0.11:8080"
                ],
                "upstream_options": [
                  {
                    "address": "10.0.0.10:8080",
                    "weight": 2,
                    "backup": false
                  },
                  {
                    "address": "10.0.0.11:8080",
                    "weight": 1,
                    "backup": false
                  }
                ],
                "load_balance": {
                  "strategy": "round_robin"
                },
                "health_check": null,
                "max_fails": 3,
                "fail_duration_ms": 30000,
                "headers_up": {
                  "Host": "app.internal"
                },
                "headers_down": {},
                "headers_down_default": {
                  "X-Served-By": "pingclair"
                },
                "headers_up_remove": [
                  "Cookie"
                ],
                "flush_interval": null,
                "read_timeout": 120000,
                "write_timeout": null,
                "connect_timeout": 5000,
                "first_byte_timeout": null,
                "between_reads_timeout": null,
                "retry": {
                  "max_attempts": 16,
                  "total_timeout_ms": 3000,
                  "backoff_ms": 250
                },
                "overload": {
                  "max_in_flight": null,
                  "max_pending": 0,
                  "pending_timeout_ms": 1000,
                  "upstream_max_connections": null
                },
                "circuit_breaker": {
                  "consecutive_failures": null,
                  "error_rate_percent": null,
                  "minimum_requests": 20,
                  "window_requests": 100,
                  "open_duration_ms": 30000,
                  "half_open_requests": 1,
                  "failure_statuses": []
                },
                "upstream_tls": {
                  "enable": false,
                  "server_name": null,
                  "trusted_ca_certs": [],
                  "client_cert": null,
                  "client_key": null,
                  "insecure_skip_verify": false
                },
                "cache": {
                  "ttl_secs": 30,
                  "max_size_bytes": 134217728
                }
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/api",
                "/api/*"
              ]
            }
          }
        },
        {
          "path": "/*",
          "handler": {
            "type": "file_server",
            "root": "./public",
            "index": [
              "index.html"
            ],
            "browse": false,
            "browse_limit": null,
            "compress": false,
            "canonical_uris": true
          },
          "methods": null,
          "matcher": null
        }
      ],
      "log": null,
      "client_max_body_size": 0,
      "limits": {
        "header_timeout_ms": null,
        "body_timeout_ms": null,
        "idle_timeout_ms": null,
        "request_timeout_ms": null,
        "max_header_count": null,
        "max_header_bytes": null,
        "max_connections": null,
        "upload_bytes_per_sec": null,
        "download_bytes_per_sec": null,
        "long_connections": {
          "idle_timeout_ms": null,
          "request_timeout_ms": null
        }
      },
      "security": {
        "enabled": false,
        "x_frame_options": "",
        "x_content_type_options": "",
        "x_xss_protection": "",
        "x_permitted_cross_domain": "",
        "referrer_policy": "",
        "permissions_policy": "",
        "hsts": null,
        "csp": null
      },
      "gzip_types": [
        "text/*",
        "application/json",
        "application/*+json",
        "application/x-ndjson",
        "application/json-seq",
        "application/xml",
        "application/*+xml",
        "application/javascript",
        "application/x-javascript",
        "image/svg+xml"
      ],
      "encodings": [],
      "error_pages": {}
    }
  ],
  "admin": null,
  "global": {
    "email": null,
    "http_port": 80,
    "https_port": 443,
    "metrics": false,
    "auto_https": "on",
    "blocked_ips": [],
    "trusted_proxies": [],
    "upstream_keepalive_pool_size": null,
    "http3": true,
    "worker_threads": null,
    "dns_refresh_secs": 30,
    "grace_period_secs": null
  },
  "logging": {}
}
