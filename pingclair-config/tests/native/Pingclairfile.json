{
  "debug": false,
  "servers": [
    {
      "name": "static.example.test",
      "names": [
        "static.example.test"
      ],
      "bind": null,
      "listen": [
        "[::]:8080"
      ],
      "proxy_protocol_listen": [],
      "plaintext_listen": [
        "[::]:8080"
      ],
      "tls": null,
      "routes": [
        {
          "path": "/assets*",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "headers",
                "set": {
                  "Cache-Control": "public, max-age=3600"
                },
                "remove": []
              },
              {
                "type": "file_server",
                "root": "./public/assets",
                "index": [
                  "index.html"
                ],
                "browse": false,
                "browse_limit": null,
                "compress": true,
                "canonical_uris": true
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/assets",
                "/assets/*"
              ]
            }
          }
        },
        {
          "path": "/*",
          "handler": {
            "type": "file_server",
            "root": "./public",
            "index": [
              "index.html"
            ],
            "browse": false,
            "browse_limit": null,
            "compress": true,
            "canonical_uris": true
          },
          "methods": null,
          "matcher": null
        }
      ],
      "log": {
        "output": {
          "file": "/tmp/pingclair-access.log"
        },
        "format": "text",
        "level": null,
        "exclude_fields": [],
        "rotation": {
          "compress": false
        },
        "request_headers": [],
        "response_headers": [],
        "include_tls": false
      },
      "client_max_body_size": 0,
      "limits": {
        "header_timeout_ms": null,
        "body_timeout_ms": null,
        "idle_timeout_ms": null,
        "request_timeout_ms": null,
        "send_timeout_ms": null,
        "max_header_count": null,
        "max_header_bytes": null,
        "max_connections": null,
        "keepalive_requests": null,
        "upload_bytes_per_sec": null,
        "download_bytes_per_sec": null,
        "long_connections": {
          "idle_timeout_ms": null,
          "request_timeout_ms": null
        }
      },
      "security": {
        "enabled": false,
        "x_frame_options": "",
        "x_content_type_options": "",
        "x_xss_protection": "",
        "x_permitted_cross_domain": "",
        "referrer_policy": "",
        "permissions_policy": "",
        "hsts": null,
        "csp": null
      },
      "gzip_types": [
        "text/*",
        "application/json",
        "application/*+json",
        "application/x-ndjson",
        "application/json-seq",
        "application/xml",
        "application/*+xml",
        "application/javascript",
        "application/x-javascript",
        "image/svg+xml"
      ],
      "encodings": [
        "zstd",
        "gzip"
      ],
      "error_pages": {
        "404": "./public/index.html"
      }
    }
  ],
  "admin": null,
  "global": {
    "email": null,
    "http_port": 80,
    "https_port": 443,
    "metrics": true,
    "auto_https": "on",
    "blocked_ips": [],
    "trusted_proxies": [],
    "upstream_keepalive_pool_size": null,
    "http3": true,
    "worker_threads": null,
    "dns_refresh_secs": 30,
    "grace_period_secs": null
  },
  "logging": {}
}
