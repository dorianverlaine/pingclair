        "x_content_type_options": "",
        "x_xss_protection": "",
        "x_permitted_cross_domain": "",
        "referrer_policy": "",
        "permissions_policy": "",
        "hsts": null,
        "csp": null
      },
      "gzip_types": [
        "text/*",
        "application/json",
        "application/*+json",
        "application/x-ndjson",
        "application/json-seq",
        "application/xml",
        "application/*+xml",
        "application/javascript",
        "application/x-javascript",
        "image/svg+xml"
      ],
      "encodings": [],
