  "layer4": [
    {
      "listen": ":9443",
      "max_connections": 2048,
      "preread_timeout_ms": 30000,
      "preread_buffer_size": 16384,
      "proxy_connect_timeout_ms": 5000,
      "proxy_timeout_ms": 300000,
      "proxy_half_close": true,
      "proxy_buffer_size": 16384,
      "routes": [
        {
          "matches": [
            {
              "tls": {
                "sni": [
                  "tunnel.example.test"
                ],
                "alpn": []
              }
            }
          ],
          "upstream": "10.0.0.20:8443"
        },
        {
          "matches": [],
          "upstream": "10.0.0.21:443"
        }
      ]
    }
  ],
  "admin": null,
  "global": {
    "email": null,
