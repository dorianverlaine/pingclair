{
  "debug": false,
  "servers": [
    {
      "name": "app.example.test",
      "names": [
        "app.example.test"
      ],
      "bind": null,
      "listen": [
        "[::]:8080"
      ],
      "proxy_protocol_listen": [],
      "plaintext_listen": [
        "[::]:8080"
      ],
      "tls": null,
      "routes": [
        {
          "path": "/admin*",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "basic_auth",
                "realm": "Admin Area",
                "credentials": [
                  {
                    "username": "alice",
                    "password": "$2y$04$BjuNmKvAV.mEi7.yFrazX.S6w6OO7H0BzQfyVVFZBq/qbVXCVNX4W",
                    "algorithm": "bcrypt"
                  }
                ]
              },
              {
                "type": "file_server",
                "root": "./admin",
                "index": [
                  "index.html"
                ],
                "browse": false,
                "browse_limit": null,
                "compress": false,
                "canonical_uris": true
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/admin",
                "/admin/*"
              ]
            }
          }
        },
        {
          "path": "/api*",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "cors",
                "allowed_origins": [
                  "https://app.example.test"
                ],
                "allowed_methods": [
                  "GET",
                  "POST"
                ],
                "allowed_headers": [
                  "Content-Type",
                  "Authorization",
                  "X-Requested-With"
                ],
                "exposed_headers": [],
                "allow_credentials": true,
                "max_age": 600
              },
              {
                "type": "rate_limit",
                "requests": 100,
                "window_secs": 60,
                "by_ip": false,
                "burst": 20,
                "key": {
                  "header": "X-Tenant-ID"
                },
                "dry_run": false
              },
              {
                "type": "vars",
                "values": {
                  "tier": "free"
                }
              },
              {
                "type": "request_body",
                "max_size": 10485760,
                "read_timeout_ms": 30000
              },
              {
                "type": "reverse_proxy",
                "upstreams": [
                  "10.0.0.10:8080"
                ],
                "upstream_options": [
                  {
                    "address": "10.0.0.10:8080",
                    "weight": 1,
                    "backup": false
                  }
                ],
                "load_balance": {
                  "strategy": ""
                },
                "health_check": null,
                "headers_up": {},
                "headers_down": {},
                "flush_interval": null,
                "read_timeout": null,
                "write_timeout": null,
                "connect_timeout": null,
                "first_byte_timeout": null,
                "between_reads_timeout": null,
                "retry": {
                  "max_attempts": 16,
                  "total_timeout_ms": null,
                  "backoff_ms": 0
                },
                "overload": {
                  "max_in_flight": null,
                  "max_pending": 0,
                  "pending_timeout_ms": 1000,
                  "upstream_max_connections": null
                },
                "circuit_breaker": {
                  "consecutive_failures": null,
                  "error_rate_percent": null,
                  "minimum_requests": 20,
                  "window_requests": 100,
                  "open_duration_ms": 30000,
                  "half_open_requests": 1,
                  "failure_statuses": []
                },
                "upstream_tls": {
                  "enable": false,
                  "server_name": null,
                  "trusted_ca_certs": [],
                  "client_cert": null,
                  "client_key": null,
                  "insecure_skip_verify": false
                },
                "cache": null
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/api",
                "/api/*"
              ]
            }
          }
        },
        {
          "path": "/internal*",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "access_control",
                "allowed_ips": [
                  "10.0.0.0/8"
                ],
                "denied_ips": [],
                "allowed_referers": [],
                "denied_referers": [],
                "allowed_user_agents": [],
                "denied_user_agents": [
                  "(curl)"
                ]
              },
              {
                "type": "respond",
                "status": 200,
                "body": {
                  "literal": "intranet only"
                },
                "headers": {}
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/internal",
                "/internal/*"
              ]
            }
          }
        },
        {
          "path": "/health",
          "handler": {
            "type": "pipeline",
            "handlers": [
              {
                "type": "log_skip"
              },
              {
                "type": "respond",
                "status": 200,
                "body": {
                  "literal": "ok"
                },
                "headers": {}
              }
            ]
          },
          "methods": null,
          "matcher": {
            "path": {
              "patterns": [
                "/health"
              ]
            }
          }
        },
        {
          "path": "/*",
          "handler": {
            "type": "error",
            "status": 404,
            "message": {
              "literal": "not found"
            }
          },
          "methods": null,
          "matcher": null
        }
      ],
      "log": null,
      "client_max_body_size": 0,
      "limits": {
        "header_timeout_ms": null,
        "body_timeout_ms": null,
        "idle_timeout_ms": null,
        "request_timeout_ms": null,
        "send_timeout_ms": null,
        "max_header_count": null,
        "max_header_bytes": null,
        "max_connections": null,
        "keepalive_requests": null,
        "upload_bytes_per_sec": null,
        "download_bytes_per_sec": null,
        "long_connections": {
          "idle_timeout_ms": null,
          "request_timeout_ms": null
        }
      },
      "security": {
        "enabled": false,
        "x_frame_options": "",
        "x_content_type_options": "",
        "x_xss_protection": "",
        "x_permitted_cross_domain": "",
        "referrer_policy": "",
        "permissions_policy": "",
        "hsts": null,
        "csp": null
      },
      "gzip_types": [
        "text/*",
        "application/json",
        "application/*+json",
        "application/x-ndjson",
        "application/json-seq",
        "application/xml",
        "application/*+xml",
        "application/javascript",
        "application/x-javascript",
        "image/svg+xml"
      ],
      "encodings": [],
      "error_pages": {}
    }
  ],
  "admin": null,
  "global": {
    "email": null,
    "http_port": 80,
    "https_port": 443,
    "metrics": false,
    "auto_https": "on",
    "blocked_ips": [],
    "trusted_proxies": [],
    "upstream_keepalive_pool_size": null,
    "http3": true,
    "worker_threads": null,
    "dns_refresh_secs": 30,
    "grace_period_secs": null
  },
  "logging": {}
}
