+enum QpackInteger {
+    Complete { value: u64, len: usize },
+    Incomplete,
+    Overflow,
+}
+
+/// 🧮 Decodes a QPACK prefixed integer without consuming an incomplete suffix.
+fn qpack_integer(buf: &[u8], prefix_bits: u8) -> QpackInteger {
+    let Some(&first) = buf.first() else {
+        return QpackInteger::Incomplete;
+    };
+    let mask = (1_u8 << prefix_bits) - 1;
+    let mut value = u64::from(first & mask);
+    if value < u64::from(mask) {
+        return QpackInteger::Complete { value, len: 1 };
+    }
+
+    let mut shift = 0_u32;
+    for (index, byte) in buf.iter().copied().enumerate().skip(1) {
+        let Some(chunk) = u64::from(byte & 0x7f).checked_shl(shift) else {
+            return QpackInteger::Overflow;
+        };
+        let Some(next) = value.checked_add(chunk) else {
+            return QpackInteger::Overflow;
+        };
+        value = next;
+
+        if byte & 0x80 == 0 {
+            return QpackInteger::Complete {
+                value,
+                len: index + 1,
+            };
+        }
+
+        shift += 7;
+        if shift >= 63 {
+            return QpackInteger::Overflow;
+        }
+    }
+
+    QpackInteger::Incomplete
+}
+
+fn process_qpack_encoder_stream<F: BufFactory>(
+    conn: &mut super::Connection<F>, streams: &mut QpackStreams,
+    max_table_capacity: u64,
+) -> Result<()> {
+    let mut consumed = 0;
+    while let Some(&first) = streams.encoder_stream_buf.get(consumed) {
+        // 🧱 We do not implement a dynamic QPACK table. With the advertised
+        // capacity at zero, the only valid encoder instruction is setting that
+        // same capacity to zero.
+        if first & 0xe0 != 0x20 {
+            return qpack_stream_error(conn, Error::QpackEncoderStreamError);
+        }
+
+        let (value, len) = match qpack_integer(&streams.encoder_stream_buf[consumed..], 5) {
+            QpackInteger::Complete { value, len } => (value, len),
+            QpackInteger::Incomplete => break,
+            QpackInteger::Overflow =>
+                return qpack_stream_error(conn, Error::QpackEncoderStreamError),
+        };
+        if value > max_table_capacity {
+            return qpack_stream_error(conn, Error::QpackEncoderStreamError);
+        }
+        consumed += len;
+    }
+    streams.encoder_stream_buf.drain(..consumed);
+
+    if streams.encoder_stream_buf.len() > 16 {
+        return qpack_stream_error(conn, Error::QpackEncoderStreamError);
+    }
+    Ok(())
+}
+
+fn process_qpack_decoder_stream<F: BufFactory>(
+    conn: &mut super::Connection<F>, streams: &mut QpackStreams,
+) -> Result<()> {
+    let mut consumed = 0;
+    while let Some(&first) = streams.decoder_stream_buf.get(consumed) {
+        let (prefix_bits, is_increment) = match first >> 6 {
+            0 => (6, true),
+            1 => (7, false),
+            2 => (6, false),
+            _ => return qpack_stream_error(conn, Error::QpackDecoderStreamError),
+        };
+
+        let (value, len) = match qpack_integer(&streams.decoder_stream_buf[consumed..], prefix_bits)
+        {
+            QpackInteger::Complete { value, len } => (value, len),
+            QpackInteger::Incomplete => break,
+            QpackInteger::Overflow =>
+                return qpack_stream_error(conn, Error::QpackDecoderStreamError),
+        };
+        if is_increment && value == 0 {
+            return qpack_stream_error(conn, Error::QpackDecoderStreamError);
+        }
+        consumed += len;
+    }
+    streams.decoder_stream_buf.drain(..consumed);
+
+    if streams.decoder_stream_buf.len() > 16 {
+        return qpack_stream_error(conn, Error::QpackDecoderStreamError);
+    }
+    Ok(())
+}
+
+fn qpack_stream_error<F: BufFactory>(
+    conn: &mut super::Connection<F>, error: Error,
+) -> Result<()> {
+    conn.close(true, error.to_wire(), b"Invalid QPACK stream instruction.")?;
+    Err(error)
