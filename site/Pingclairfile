# 🏝️ pingclair.com — the docs site, served by Pingclair from a FreeBSD
# node, with pingclair.pingclair.com kept as the staging alias and
# www redirected to the apex.
{
	email team@pingclair.com
	storage file_system /var/db/pingclair

	# 🔁 The Admin API on loopback, so `pingclair reload` can hot-reload this
	# file instead of a restart dropping connections.
	admin 127.0.0.1:2019
}

# 🔗 The headers the documentation Worker published through the build output's
# `_headers` file; the file server does not read that file, so the same set is
# stated once here and imported by every site.
(edge_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Link "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"describedby\", </sitemap.xml>; rel=\"sitemap\""
	}
}

# 🧊 The one-line install address: `https://pingclair.com/install.sh`.
#
# The script lives in the server repository and is published to the release
# bucket by every release; proxying it here rather than keeping a copy is the
# same choice the Cloudflare Worker made — there is no second file to drift.
(installer) {
	rewrite * /pingclair/install.sh
	reverse_proxy releases.pingclair.com:443 {
		header_up Host releases.pingclair.com
		header_down ?X-Installer-Source r2
		transport http {
			tls
			tls_server_name releases.pingclair.com
		}
		cache {
			ttl 5m
			max_size 16777216
		}
	}
}

# 🤖 The agent endpoints still served by the documentation Worker; the docs
# node proxies them so `pingclair.com/mcp` and `/a2a` keep the URL contract
# the Worker era established.
(worker) {
	reverse_proxy cf.pingclair.com:443 {
		header_up Host cf.pingclair.com
		transport http {
			tls
			tls_server_name cf.pingclair.com
		}
	}
}

# 📓 One JSON line per request, rotated by Pingclair itself. Every site imports
# it, so the redirecting www host is logged too.
(access_log) {
	log {
		output file /var/log/pingclair-access.log {
			roll_size 100MiB
			roll_keep 7
		}
		format json
		headers {
			request User-Agent
		}
	}
}

(docs) {
	root * /usr/local/www/pingclair.pingclair.com
	encode zstd gzip

	import access_log

	# 😈 Vulnerability scanners walk a fixed list of paths this static site has
	# never had: environment files, VCS metadata, PHP entry points, admin
	# panels. They get a 404 with one emoji instead of the 404 page, so the
	# answer costs nothing and says nothing.
	@scanner path */.env* */.git* */.svn* */.hg/* */.aws* */.ssh* */.DS_Store *.php *.php7 *.phtml */wp-* */phpmyadmin* */pma/* */cgi-bin/* */actuator* */.vscode* */.idea* *.sql *.bak *.old *.swp /config.json /server-status /server-info
	handle @scanner {
		respond "😈" 404
	}

	# 📌 Each `reverse_proxy` sits in its own top-level `handle`: a build of
	# Pingclair before the fix for proxies nested in one `route` sent every
	# request of that route to its first proxy. Mutually exclusive `handle`
	# blocks are ordered by path specificity, with the catch-all last.
	handle /install.sh {
		import installer
	}
	handle /install {
		import installer
	}
	handle /mcp {
		import worker
	}
	handle /a2a {
		import worker
	}

	# 🗂️ Rules the Cloudflare side applied at the edge: immutable cache
	# for build assets, a short cache for the search index, plain text for
	# direct Markdown fetches, cross-origin discovery catalogs, and the API
	# catalog's RFC 9727 media type.
	handle /_astro/* {
		import edge_headers
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /pagefind/* {
		import edge_headers
		header Cache-Control "public, max-age=3600"
		file_server
	}
	@markdown_file path *.md
	handle @markdown_file {
		import edge_headers
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle /.well-known/api-catalog {
		import edge_headers
		header Access-Control-Allow-Origin *
		header Content-Type application/linkset+json
		file_server
	}
	handle /.well-known/* {
		import edge_headers
		header Access-Control-Allow-Origin *
		file_server
	}

	# 📄 A client that prefers Markdown gets the page's twin on the same URL:
	# `start/install.md` for `/start/install/`, or the directory's
	# `index.md`. The preference is read from `Accept` quality values, so
	# `text/markdown;q=0` is a refusal, a browser's `*/*` keeps the HTML, and
	# an agent's `text/markdown, text/html` gets the Markdown it named. Every
	# page response carries `Vary: Accept` for caches.
	handle {
		import edge_headers
		file_server {
			negotiate markdown
		}
	}

	# 🧾 Starlight ships a 404 page; unknown paths answer with it, the same as
	# the Cloudflare deployment's `not_found_handling`.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

pingclair.com {
	import docs
}

pingclair.pingclair.com {
	import docs
}

# ➡️ 308 to the apex, the same permanent move the Cloudflare zone answered,
# now with the path and query riding along.
www.pingclair.com {
	import access_log
	redir https://pingclair.com{uri} 308
}
