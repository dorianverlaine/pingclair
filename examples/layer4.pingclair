# 🔌 TCP routing by TLS ClientHello, written where upstream keeps it: a
# `layer4` block among the global options.
#
# The listener reads the ClientHello without terminating TLS, picks a route by
# SNI and ALPN, and forwards the original bytes, so TLS stays end to end. Timeouts
# and buffers take nginx's stream-module names.
{
	layer4 {
		:9443 {
			preread_timeout 10s
			proxy_connect_timeout 5s
			proxy_timeout 5m
			proxy_half_close on

			@git tls sni git.example.test
			route @git {
				proxy 10.0.0.20:443
			}

			@internal {
				tls
				remote_ip 10.0.0.0/8
			}
			route @internal {
				proxy 10.0.0.21:443
			}

			route {
				proxy 127.0.0.1:8443
			}
		}
	}
}
