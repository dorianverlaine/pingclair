// 🔀 A reverse proxy: header surgery on both halves of the exchange, a rewrite,
// and two upstreams in rotation.
//
// 📌 Components run in the order they are written and the last one answers, so
// this route reads top to bottom as the request's journey.
HTTPListener(on: ":8080") {
    Site(host: "app.example.test") {
        Route(when: .path(prefix: "/api")) {
            RequestHeader(.set("X-Request-Start", "pingclair"), .remove("Cookie"))
            Rewrite(stripPrefix: "/api")
            Proxy(
                to: ["10.0.0.10:8080", "10.0.0.11:8080"],
                headersUp: [.set("Host", "app.internal"), .remove("Cookie")],
                headersDown: [.setIfAbsent("X-Served-By", "pingclair")],
                loadBalance: .roundRobin,
                upstreamWeights: [2, 1],
                tryDuration: .seconds(3),
                tryInterval: .milliseconds(250),
                maxFails: 3,
                failDuration: .seconds(30),
                connectTimeout: .seconds(5),
                readTimeout: .minutes(2),
            )
            // 🏷️ The components' own header actions, aimed at the upstream
            // half and the downstream half of the exchange.
            // 🎛️ Two upstreams, weighed, with the retry budget and the
            // passive health that go with them.
        }
        Fallback { ServeFiles(root: "./public") }
    }
}
