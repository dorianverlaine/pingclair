// 🔀 A reverse proxy: header surgery on both halves of the exchange, a
// rewrite, and two upstreams in rotation.
//
// 📌 Components run in the order they are written and the last one answers.
// Identity stays in the call — the address list and the header policy — and
// everything about *how* to proxy is a modifier, so the line reads as the
// thing being described.
HTTPListener(on: ":8080") {
    Site(host: "app.example.test") {
        Route(when: .path(prefix: "/api")) {
            RequestHeader(.set("X-Request-Start", "pingclair"), .remove("Cookie"))
            Rewrite(stripPrefix: "/api")
            Proxy(to: [.upstream("10.0.0.10:8080", weight: 2), .upstream("10.0.0.11:8080")], headersUp: [.set("Host", "app.internal"), .remove("Cookie")], headersDown: [.setIfAbsent("X-Served-By", "pingclair")])
            .loadBalance(.roundRobin)
            .retry(
                tryDuration: .seconds(3),
                tryInterval: .milliseconds(250),
                maxFails: 3,
                failDuration: .seconds(30),
            )
            .timeouts(connect: .seconds(5), read: .minutes(2))
            // 🗄️ Store fresh upstream responses for a while; the ceiling is
            // process-wide and shared by every cached route.
            .cache(ttl: .seconds(30), maxSize: .mebibytes(128))
        }

        // 🌐 DNS-discovered upstreams: the peers come from the service records
        // of one name, refreshed on their own schedule.
        Route(when: .path(exact: "/discovered")) {
            Proxy(dynamic: .srv(
                "backend.example.test",
                service: "https",
                proto: .tcp,
                refresh: .seconds(30),
                grace: .seconds(30),
            ))
        }
        Fallback { ServeFiles(root: "./public") }
    }
}
