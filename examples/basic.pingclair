// 🧭 The smallest useful configuration.
//
// 📌 A `let` binding is substituted where it is used, and a Site's body is an
// ordered list of Route, ErrorRoute and Fallback components.
let host = "example.test"

HTTPListener(on: ":8080") {
    Site(host: host) {
        Fallback { Respond(body: "hello from Pingclair") }
    }
}
