{
  "global": {
    "auto_https": "off",
    "http3": true,
    "metrics": false,
    "worker_threads": 2
  },
  "servers": [
    {
      "name": "bench.local",
      "listen": ["0.0.0.0:8080"],
      "routes": [
        {
          "path": "/proxy/*",
          "handler": {
            "type": "reverse_proxy",
            "upstreams": ["http://127.0.0.1:9000"],
            "flush_interval": -1
          }
        },
        {
          "path": "/*",
          "handler": {
            "type": "file_server",
            "root": "/var/www/html",
            "index": [],
            "browse": false,
            "compress": false
          }
        }
      ]
    },
    {
      "name": "h3.local",
      "listen": ["0.0.0.0:8443"],
      "tls": {
        "cert": "/tmp/bench.crt",
        "key": "/tmp/bench.key",
        "http3": true
      },
      "routes": [
        {
          "path": "/proxy/*",
          "handler": {
            "type": "reverse_proxy",
            "upstreams": ["http://127.0.0.1:9000"],
            "flush_interval": -1
          }
        },
        {
          "path": "/*",
          "handler": {
            "type": "file_server",
            "root": "/var/www/html",
            "index": [],
            "browse": false,
            "compress": false
          }
        }
      ]
    }
  ]
}
