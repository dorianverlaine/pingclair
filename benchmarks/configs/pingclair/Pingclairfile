# Benchmark config for Pingclair.
# Mirrors nginx/nginx.conf and caddy/Caddyfile as closely as each engine's
# config language allows: static file root + gzip on, and a /proxy/* route
# forwarded to the shared "backend" upstream (not itself measured).
#
# Uses a named site address (`bench.local:8080`) like the nginx and caddy
# configs do. The caddyfile adapter binds hostname-based addresses on
# 0.0.0.0 and routes by the Host header (Caddy/nginx semantics); the wrk
# and curl invocations in scripts/ all send `Host: bench.local`.

global {
    debug false
}

bench.local:8080 {
    compress gzip

    handle /proxy/* {
        reverse_proxy backend:9000
    }

    file_server /var/www/html
}
